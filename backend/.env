# Environment configuration
# Copy this file to .env and update values

# Application
APP_NAME=Tunisia Markets Hub
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tunisia_markets
# DATABASE_URL=postgresql+asyncpg://hamza:shadow@postgres:5432/tunisia_markets
DATABASE_URL=postgresql://hamza:shadow@localhost:5434/tunisia-live-data-dashboard
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tunisia_markets

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# External APIs
# BVMT_BASE_URL=https://www.bvmt.com.tn
BVMT_BASE_URL=https://tunis-stockexchange.com
BCT_BASE_URL=https://www.bct.gov.tn
EXCHANGERATE_API_URL=https://api.exchangerate.host
ECB_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# Scraping
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; TunisiaMarketsBot/1.0; +https://tunisia-markets.com/bot)

# Scheduling (cron format)
STOCK_INGESTION_CRON=0 18 * * 1-5
FX_INGESTION_CRON=0 * * * *
ANOMALY_DETECTION_CRON=0 19 * * 1-5

# AdSense
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_CHART=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_IN_CONTENT=

# Frontend URL
FRONTEND_URL=http://localhost:3000
# https://live-tn-markets.vercel.app

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Security
# SECRET_KEY=change-this-in-production
SECRET_KEY=$m!m1m0o65e=c$jij!yl_vo0v6eo8a7k8jd*!g2wp59(d#sdm#